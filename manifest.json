{
  "manifest_version": 3,
  "name": "TikTok Random Liked",
  "version": "3.5",
  "description": "Random xem video đã Like trên TikTok",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "commands": {
    "skip-and-delete": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "Bỏ qua và xoá video đang phát",
      "global": true
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "player.html",
        "style-player.css",
        "js/player/player-cdn-refresh.js",
        "js/player/player-audio.js",
        "js/player/player-app.js",
        "js/content/content-cdn-bridge.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "js/content/crawler/selectors.js",
        "js/content/crawler/content-utils.js",
        "js/content/stealth/content-stealth.js",
        "js/content/behavior/content-behavior.js",
        "js/content/stealth/content-interceptor.js",
        "js/content/video/content-video-recovery.js",
        "js/content/video/content-video-smart.js",
        "js/content/video/content-video-watcher.js",
        "js/content/crawler/content-checkpoint.js",
        "js/content/crawler/content-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}